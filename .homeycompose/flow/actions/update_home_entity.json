{
  "id": "update_home_entity",
  "title": {
    "en": "Update home screen entity"
  },
  "titleFormatted": {
    "en": "Set home [[entity]] to [[value]] with icon [[icon]]"
  },
  "hint": {
    "en": "Update an entity display on the NSPanel home screen (chips, values, etc.)"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "type": "dropdown",
      "name": "entity",
      "title": {
        "en": "Entity"
      },
      "values": [
        { "id": "chip01", "label": { "en": "Chip 1" } },
        { "id": "chip02", "label": { "en": "Chip 2" } },
        { "id": "chip03", "label": { "en": "Chip 3" } },
        { "id": "chip04", "label": { "en": "Chip 4" } },
        { "id": "chip05", "label": { "en": "Chip 5" } },
        { "id": "chip06", "label": { "en": "Chip 6" } },
        { "id": "outdoor_temp", "label": { "en": "Outdoor Temperature" } },
        { "id": "indoor_temp", "label": { "en": "Indoor Temperature" } },
        { "id": "weather_icon", "label": { "en": "Weather Icon" } },
        { "id": "date", "label": { "en": "Date Display" } },
        { "id": "time", "label": { "en": "Time Display" } }
      ]
    },
    {
      "type": "text",
      "name": "value",
      "title": {
        "en": "Value/Text"
      },
      "placeholder": {
        "en": "Display value"
      }
    },
    {
      "type": "text",
      "name": "icon",
      "title": {
        "en": "Icon (MDI codepoint)"
      },
      "placeholder": {
        "en": "e.g. \\uE599 for sunny"
      }
    }
  ]
}
