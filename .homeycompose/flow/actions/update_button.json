{
  "id": "update_button",
  "title": {
    "en": "Update button appearance"
  },
  "titleFormatted": {
    "en": "Set [[button]] on [[page]] to [[label]] ([[state]])"
  },
  "hint": {
    "en": "Update the appearance of a button on the NSPanel"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "type": "dropdown",
      "name": "page",
      "title": {
        "en": "Page"
      },
      "values": [
        { "id": "buttonpage01", "label": { "en": "Button Page 1" } },
        { "id": "buttonpage02", "label": { "en": "Button Page 2" } },
        { "id": "buttonpage03", "label": { "en": "Button Page 3" } },
        { "id": "buttonpage04", "label": { "en": "Button Page 4" } }
      ]
    },
    {
      "type": "dropdown",
      "name": "button",
      "title": {
        "en": "Button"
      },
      "values": [
        { "id": "bt01", "label": { "en": "Button 1" } },
        { "id": "bt02", "label": { "en": "Button 2" } },
        { "id": "bt03", "label": { "en": "Button 3" } },
        { "id": "bt04", "label": { "en": "Button 4" } },
        { "id": "bt05", "label": { "en": "Button 5" } },
        { "id": "bt06", "label": { "en": "Button 6" } },
        { "id": "bt07", "label": { "en": "Button 7" } },
        { "id": "bt08", "label": { "en": "Button 8" } }
      ]
    },
    {
      "type": "text",
      "name": "label",
      "title": {
        "en": "Label"
      },
      "placeholder": {
        "en": "Button label"
      }
    },
    {
      "type": "checkbox",
      "name": "state",
      "title": {
        "en": "On/Off State"
      }
    }
  ]
}
