{
  "id": "be.titansofindustry.nspanel",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "NSPanel for Homey"
  },
  "description": {
    "en": "Fast, configurable Homey dashboard for the Sonoff NSPanel."
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:geolocation",
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Tim Broddin",
    "email": "tim@wannabes.be"
  },
  "brandColor": "#e94560",
  "api": {
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getIcons": {
      "method": "GET",
      "path": "/icons"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config/:deviceId"
    },
    "putConfig": {
      "method": "PUT",
      "path": "/config/:deviceId"
    },
    "getMoods": {
      "method": "GET",
      "path": "/moods"
    },
    "getFlows": {
      "method": "GET",
      "path": "/flows"
    },
    "postCalendarTest": {
      "method": "POST",
      "path": "/calendar/test"
    }
  }
}
